{
  "realm": "spring-boot-quickstart",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "user", "description": "일반 사용자" },
      { "name": "admin", "description": "관리자" }
    ]
  },
  "users": [
    {
      "username": "user1",
      "enabled": true,
      "email": "user1@example.com",
      "firstName": "User",
      "lastName": "One",
      "credentials": [{ "type": "password", "value": "user1", "temporary": false }],
      "realmRoles": ["user"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@example.com",
      "firstName": "Admin",
      "lastName": "One",
      "credentials": [{ "type": "password", "value": "admin1", "temporary": false }],
      "realmRoles": ["user", "admin"]
    }
  ],
  "clients": [
    {
      "clientId": "spring-cloud-gateway",
      "name": "spring-cloud-gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "3IvMKnk3AmO2NEmXav4Dy3jEITpIX0pZ",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "redirectUris": ["http://localhost:8060/*"],
      "webOrigins": ["http://localhost:8060"],
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "decisionStrategy": "UNANIMOUS",
        "resources": [
          {
            "name": "callme-resource",
            "type": "urn:spring-cloud-gateway:resources:callme",
            "ownerManagedAccess": false,
            "uris": ["/callme/*"],
            "scopes": [{ "name": "GET" }, { "name": "POST" }]
          },
          {
            "name": "other-resource",
            "type": "urn:spring-cloud-gateway:resources:other",
            "ownerManagedAccess": false,
            "uris": ["/other/*"],
            "scopes": [{ "name": "GET" }, { "name": "POST" }]
          }
        ],
        "scopes": [{ "name": "GET" }, { "name": "POST" }],
        "policies": [
          {
            "name": "user-role-policy",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": { "roles": "[{\"id\":\"user\",\"required\":true}]" }
          },
          {
            "name": "admin-role-policy",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": { "roles": "[{\"id\":\"admin\",\"required\":true}]" }
          },
          {
            "name": "callme-permission",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"callme-resource\"]",
              "applyPolicies": "[\"user-role-policy\"]"
            }
          },
          {
            "name": "other-permission",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"other-resource\"]",
              "applyPolicies": "[\"admin-role-policy\"]"
            }
          }
        ]
      }
    }
  ]
}
